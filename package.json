{
  "name": "no-mercy",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter @mercy/web dev",
    "serve": "bun run packages/server/src/main.ts",
    "build": "bun --filter @mercy/web build",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/web/tsconfig.json",
    "sim": "bun run packages/engine/test/simulate.ts",
    "bench": "bun run packages/engine/test/benchmark.ts",
    "deck": "bun run packages/engine/test/deck-report.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "typescript": "6.0.3"
  }
}
